{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "paths": {
            "@/*": ["./resources/js/*"],
            "class-variance-authority": ["./vendor-stubs/cva.ts"],
            "radix-ui": ["./vendor-stubs/radix.tsx"]
        }
    },
    "include": ["resources/js/**/*.ts", "resources/js/**/*.tsx", "vendor-stubs/**/*"]
}
